input {
    keyboard {
        xkb
        numlock
    }
    touchpad {
        tap
        natural-scroll
    }
    mouse
    trackpoint
    warp-mouse-to-focus
    focus-follows-mouse max-scroll-amount="0%"
}

debug {
    honor-xdg-activation-with-invalid-serial
}

output "HDMI-A-1" {
    mode "1920x1080@120.000"
    scale 1
    position x=0 y=329
    layout {
        always-center-single-column
    }
}

output "eDP-1" {
    mode "1920x1080@60.052"
    scale 1
    position x=1920 y=0
    focus-at-startup
}

